# Telegram Bot Token (crear con @BotFather)
TELEGRAM_BOT_TOKEN=

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Modelo LLM usado por el agente
OPENAI_MODEL=gpt-4o-mini

# Modelo de transcripción (Whisper)
WHISPER_MODEL=whisper-1

# Idioma por defecto para la transcripción (código ISO, ej: es, en)
STT_LANGUAGE=es

# Opcional: restringir acceso a ciertos IDs de usuario de Telegram (separados por coma)
ALLOWED_USER_IDS=

# Correo personal (Gmail). Usa una "contraseña de aplicación" de Google:
# 1) Activa la verificación en dos pasos en https://myaccount.google.com/security
# 2) Genera la contraseña en https://myaccount.google.com/apppasswords
# Si dejas estos campos vacíos, el bot usará datos simulados (mock).
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
